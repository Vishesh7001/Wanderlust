<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top wander-navbar">
  <div class="container-fluid">
    <a class="navbar-brand wander-brand" href="/">
      <i class="fa-regular fa-compass"></i>
      <span>WanderLust</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav wander-nav wander-primary-nav">
        <a class="nav-link nav-link-home" href="/">
          <i class="fa-solid fa-house"></i>
          Home
        </a>
        <a class="nav-link" href="/listings">
          <i class="fa-solid fa-compass"></i>
          Explore stays
        </a>
        <% if (currentUser) { %>
          <a class="nav-link" href="/wishlist"><i class="fa-regular fa-heart"></i> Wishlist</a>
          <a class="nav-link" href="/my-trips">My Trips</a>
        <% } %>
      </div>
      <div class="navbar-nav wander-nav wander-account-nav">
        <% if (currentUser) { %>
          <a class="nav-link nav-link-cta" href="/listings/new">
            <i class="fa-solid fa-plus"></i>
            Add new Listing
          </a>
          <a class="nav-link" href="/my-listings">My Listings</a>
          <% if (currentUser.role === "host" || currentUser.role === "admin") { %><a class="nav-link" href="/host/bookings">Bookings</a><% } %>
          <a class="nav-link nav-user" href="/profile">
            <% if (currentUser.profileImage) { %><img class="nav-user-avatar" src="<%= currentUser.profileImage %>" alt="" /><% } else { %><span class="nav-user-avatar"><i class="fa-regular fa-user"></i></span><% } %>
            <span class="nav-user-name"><%= currentUser.name || currentUser.username %></span>
          </a>
          <button class="nav-logout" type="button" data-logout>Logout</button>
        <% } else { %>
          <a class="nav-link" href="/login">Login</a>
          <a class="nav-link nav-link-cta" href="/signup"><i class="fa-solid fa-arrow-right"></i> Sign up</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<% if (currentUser) { %>
  <script>
    document.querySelector("[data-logout]").addEventListener("click", async () => {
      const button = document.querySelector("[data-logout]");
      button.disabled = true;
      try {
        const response = await fetch("/logout", { method: "POST" });
        if (response.ok) window.location.href = "/login";
        else button.disabled = false;
      } catch {
        button.disabled = false;
      }
    });
  </script>
<% } %>