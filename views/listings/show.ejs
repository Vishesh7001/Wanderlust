<% layout("layouts/boilerplate") %>
  <main class="listing-detail-page">
    <a class="back-link" href="/listings">
      <i class="fa-solid fa-arrow-left"></i>
      Back to all listings
    </a>

    <div class="listing-detail-header">
      <p class="listing-eyebrow"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
      <h1><%= listing.title %></h1>
    </div>

    <%
      const rawImages = (listing.images && listing.images.length) ? listing.images : [listing.image];
      const displayImages = rawImages.map(img => {
        const url = (typeof img === "object" && img !== null) ? (img.url || "") : (img || "");
        return url.trim() || "https://images.unsplash.com/photo-1507525428034-b723cf961d3e";
      });
    %>
    <img
      src="<%= displayImages[0] %>"
      alt="<%= listing.title %>"
      class="listing-detail-image"
      onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e';"
    />
    <% if (displayImages.length > 1) { %>
      <div class="listing-detail-gallery">
        <% for (const image of displayImages.slice(1)) { %><img src="<%= image %>" alt="<%= listing.title %>" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e';" /><% } %>
      </div>
    <% } %>

    <section class="listing-detail-content">
      <div class="listing-description">
        <h2>About this place</h2>
        <p><%= listing.description %></p>
        <dl class="listing-facts">
          <div><dt>Property type</dt><dd><%= listing.propertyType || "Other" %></dd></div>
          <div><dt>Bedrooms</dt><dd><%= listing.bedrooms ?? "Not specified" %></dd></div>
          <div><dt>Bathrooms</dt><dd><%= listing.bathrooms ?? "Not specified" %></dd></div>
        </dl>
        <% if (listing.amenities && listing.amenities.length) { %>
          <h3 class="amenities-heading">What this place offers</h3>
          <ul class="listing-amenities"><% for (const amenity of listing.amenities) { %><li><i class="fa-solid fa-check"></i> <%= amenity %></li><% } %></ul>
        <% } %>
      </div>
      <div class="listing-price">
        <strong><span class="price-currency">&#8377;</span> <%= Number(listing.price || 0).toLocaleString("en-IN") %></strong>
        <span>per night</span>
      </div>
    </section>

    <section class="location-section" aria-labelledby="location-title">
      <div class="location-heading">
        <p class="listing-eyebrow">Find your way</p>
        <h2 id="location-title">Where you'll be</h2>
        <p><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
      </div>
      <% if (mapboxToken) { %>
        <div id="listing-map" class="listing-map" data-mapbox-token="<%= mapboxToken %>" data-title="<%= listing.title %>" data-location="<%= listing.location %>, <%= listing.country %>"></div>
      <% } else { %>
        <div class="map-missing">Add <code>MAPBOX_TOKEN</code> to your environment to display this map.</div>
      <% } %>
    </section>

    <% if (isOwner) { %>
      <div class="listing-actions">
        <a class="edit-button" href="/host/intelligence?listing=<%= listing._id %>"><i class="fa-solid fa-chart-line"></i> Property intelligence</a>
        <a class="edit-button" href="/listings/<%= listing._id %>/edit"><i class="fa-solid fa-pen-to-square"></i> Edit listing</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing? This cannot be undone.');">
          <button class="delete-button" type="submit"><i class="fa-regular fa-trash-can"></i> Delete listing</button>
        </form>
      </div>
    <% } %>

    <section class="booking-panel" aria-labelledby="booking-title" data-max-guests="<%= listing.maxGuests || 2 %>" data-is-owner="<%= isOwner ? "true" : "false" %>">
      <div class="booking-heading">
        <p class="listing-eyebrow">Plan your stay</p>
        <h2 id="booking-title">Choose your dates</h2>
        <p>Choose dates and guests. Availability and pricing are checked by the server.</p>
      </div>
      <div class="booking-fields">
        <div class="booking-field">
          <label for="check-in">Check-in</label>
          <div class="booking-date-control">
            <input id="check-in" type="text" value="<%= selectedCheckIn || "" %>" placeholder="Select date" autocomplete="off" required />
            <button class="date-picker-trigger" id="open-check-in" type="button" aria-label="Open check-in calendar" title="Open calendar"><i class="fa-regular fa-calendar"></i></button>
          </div>
        </div>
        <div class="booking-field">
          <label for="check-out">Check-out</label>
          <div class="booking-date-control">
            <input id="check-out" type="text" value="<%= selectedCheckOut || "" %>" placeholder="Select date" autocomplete="off" required />
            <button class="date-picker-trigger" id="open-check-out" type="button" aria-label="Open check-out calendar" title="Open calendar"><i class="fa-regular fa-calendar"></i></button>
          </div>
        </div>
        <div class="booking-field">
          <label for="booking-guests">Guests</label>
          <select id="booking-guests"><% for (let guestCount = 1; guestCount <= (listing.maxGuests || 2); guestCount++) { %><option value="<%= guestCount %>"><%= guestCount %> <%= guestCount === 1 ? "guest" : "guests" %></option><% } %></select>
        </div>
      </div>
      <div class="booking-summary" aria-live="polite">
        <div class="booking-summary-details">
          <span id="booking-nights">Select dates to check availability</span>
          <span id="booking-base-cost"></span>
          <span id="booking-gst-cost"></span>
          <span id="booking-cleaning-cost"></span>
          <span id="booking-service-cost"></span>
        </div>
        <strong id="booking-total"></strong>
        <button class="book-stay-button" id="book-stay-button" type="button" disabled>
          <i class="fa-solid fa-lock"></i>
          Continue to test payment
        </button>
      </div>
      <p class="booking-message" id="booking-message" role="status"></p>
      <dialog class="test-payment-dialog" id="test-payment-dialog" aria-labelledby="test-payment-title">
        <button class="test-payment-close" id="test-payment-close" type="button" aria-label="Close test payment">×</button>
        <p class="demo-payment-note">TEST PAYMENT · NO REAL MONEY</p>
        <h2 id="test-payment-title">Payment</h2>
        <p class="test-payment-property"><%= listing.title %></p>
        <div class="test-payment-breakdown">
          <span id="test-payment-nights">Stay</span><strong id="test-payment-subtotal"></strong>
          <span>GST (18%)</span><strong id="test-payment-gst"></strong>
          <span>Cleaning fee</span><strong id="test-payment-cleaning"></strong>
          <span>Service fee</span><strong id="test-payment-service"></strong>
          <span class="test-payment-total-label">Total</span><strong class="test-payment-total" id="test-payment-total"></strong>
        </div>
        <p class="test-payment-message" id="test-payment-message" role="status">Project payment simulation. No charge will be made.</p>
        <div class="test-payment-actions">
          <button class="form-submit" id="test-payment-pay" type="button">Pay test amount</button>
          <button class="delete-button" id="test-payment-fail" type="button">Simulate failure</button>
          <button class="clear-filters" id="test-payment-cancel" type="button">Cancel</button>
        </div>
      </dialog>
    </section>

    <section class="reviews-section" aria-labelledby="reviews-title">
      <div class="reviews-heading">
        <p class="listing-eyebrow">Guest experiences</p>
        <h2 id="reviews-title">Reviews</h2>
        <p>See what guests loved about staying here.</p>
      </div>

      <section class="review-insights-panel" aria-labelledby="review-insights-title">
        <div class="review-insights-heading">
          <p class="listing-eyebrow"><i class="fa-solid fa-sparkles"></i> AI-powered, based on guest reviews</p>
          <h3 id="review-insights-title">AI Guest Insights</h3>
        </div>
        <p class="review-insights-status" id="review-insights-status" role="status">Checking review data...</p>
        <div class="review-insights-content" id="review-insights-content" hidden>
          <p class="review-insights-sentiment" id="review-insights-sentiment"></p>
          <div class="review-insights-topics">
            <div>
              <h4>Guests frequently liked</h4>
              <ul id="review-insights-positive"></ul>
            </div>
            <div>
              <h4>Common concerns</h4>
              <ul id="review-insights-negative"></ul>
            </div>
          </div>
          <p class="review-insights-summary" id="review-insights-summary"></p>
        </div>
      </section>

      <div class="reviews-summary">
        <div class="rating-overview">
          <strong id="average-rating">4.3</strong>
          <div class="rating-stars" id="average-stars" aria-label="Average rating: 4.3 out of 5">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star-half-stroke"></i>
          </div>
          <span id="review-count">6 reviews</span>
        </div>
        <div class="rating-breakdown" id="rating-breakdown" aria-label="Rating breakdown"></div>
      </div>

      <div class="review-layout">
        <div>
          <h3 class="reviews-subtitle">Guest reviews</h3>
          <div class="reviews-list" id="reviews-list"></div>
        </div>

        <div class="review-form-panel">
          <h3 class="reviews-subtitle">Write a Review</h3>
          <p class="review-form-intro">Share your experience about this place...</p>
          <form id="review-form" class="review-form">
            <p class="review-auth-status" id="review-auth-status">Log in before submitting a review. <a href="/auth">Log in</a></p>

            <span class="review-label">Your rating</span>
            <div class="star-selector" id="star-selector" role="radiogroup" aria-label="Choose a rating">
              <button type="button" class="star-choice" data-rating="1" aria-label="1 star"><i class="fa-solid fa-star"></i></button>
              <button type="button" class="star-choice" data-rating="2" aria-label="2 stars"><i class="fa-solid fa-star"></i></button>
              <button type="button" class="star-choice" data-rating="3" aria-label="3 stars"><i class="fa-solid fa-star"></i></button>
              <button type="button" class="star-choice" data-rating="4" aria-label="4 stars"><i class="fa-solid fa-star"></i></button>
              <button type="button" class="star-choice" data-rating="5" aria-label="5 stars"><i class="fa-solid fa-star"></i></button>
            </div>
            <input id="review-rating" type="hidden" value="0" />

            <label for="review-comment">Your review</label>
            <textarea id="review-comment" placeholder="Share your experience about this place..." required></textarea>
            <button class="form-submit" type="submit">
              <i class="fa-regular fa-paper-plane"></i>
              Submit Review
            </button>
            <p class="review-success" id="review-success" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    const listingId = "<%= listing._id %>";
    const reviews = [];

    const reviewsList = document.querySelector("#reviews-list");
    const averageRating = document.querySelector("#average-rating");
    const averageStars = document.querySelector("#average-stars");
    const reviewCount = document.querySelector("#review-count");
    const ratingBreakdown = document.querySelector("#rating-breakdown");
    const reviewInsightsStatus = document.querySelector("#review-insights-status");
    const reviewInsightsContent = document.querySelector("#review-insights-content");
    const reviewInsightsSentiment = document.querySelector("#review-insights-sentiment");
    const reviewInsightsPositive = document.querySelector("#review-insights-positive");
    const reviewInsightsNegative = document.querySelector("#review-insights-negative");
    const reviewInsightsSummary = document.querySelector("#review-insights-summary");
    const reviewForm = document.querySelector("#review-form");
    const reviewRating = document.querySelector("#review-rating");
    const reviewSuccess = document.querySelector("#review-success");
    const reviewAuthStatus = document.querySelector("#review-auth-status");
    const bookingPanel = document.querySelector(".booking-panel");
    const checkIn = document.querySelector("#check-in");
    const checkOut = document.querySelector("#check-out");
    const bookingGuests = document.querySelector("#booking-guests");
    const bookingNights = document.querySelector("#booking-nights");
    const bookingTotal = document.querySelector("#booking-total");
    const bookingMessage = document.querySelector("#booking-message");
    const bookStayButton = document.querySelector("#book-stay-button");
    const testPaymentDialog = document.querySelector("#test-payment-dialog");
    const maxGuests = Number(bookingPanel.dataset.maxGuests);
    const isOwner = bookingPanel.dataset.isOwner === "true";
    const unavailableDateKeys = new Set();
    let selectedPrice = null;
    let pendingTestOrder = null;
    let paymentResolved = false;
    let checkInPicker;
    let checkOutPicker;

    const formatCurrency = (amount) => `₹${Number(amount).toLocaleString("en-IN")}`;
    const toDateKey = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
    const todayValue = toDateKey(new Date());
    const todayUtc = new Date(`${todayValue}T00:00:00.000Z`);
    const lastBookableDate = new Date(todayUtc.getTime() + 365 * 86400000);
    const lastBookableKey = lastBookableDate.toISOString().slice(0, 10);

    if (window.flatpickr) {
      checkInPicker = flatpickr(checkIn, {
        dateFormat: "Y-m-d", minDate: todayValue, maxDate: lastBookableKey,
        altInput: true, altFormat: "D, M j, Y", disable: [],
        onChange: (_, value) => {
          if (checkOutPicker) {
            checkOutPicker.set("minDate", value || todayValue);
            if (checkOut.value && checkOut.value <= value) checkOutPicker.clear();
          }
          refreshAvailability();
        },
      });
      checkOutPicker = flatpickr(checkOut, {
        dateFormat: "Y-m-d", minDate: todayValue, maxDate: lastBookableKey,
        altInput: true, altFormat: "D, M j, Y",
        onChange: refreshAvailability,
      });
    } else {
      checkIn.type = "date";
      checkOut.type = "date";
      checkIn.min = todayValue;
      checkOut.min = todayValue;
      checkIn.max = lastBookableKey;
      checkOut.max = lastBookableKey;
    }

    document.querySelector("#open-check-in").addEventListener("click", () => {
      if (checkInPicker) checkInPicker.open();
      else if (typeof checkIn.showPicker === "function") checkIn.showPicker();
      else checkIn.focus();
    });
    document.querySelector("#open-check-out").addEventListener("click", () => {
      if (checkOutPicker) checkOutPicker.open();
      else if (typeof checkOut.showPicker === "function") checkOut.showPicker();
      else checkOut.focus();
    });

    async function loadUnavailableDates() {
      const windows = [];
      for (let offset = 0; offset < 365; offset += 90) {
        const fromDate = new Date(todayUtc.getTime() + offset * 86400000);
        const toDate = new Date(todayUtc.getTime() + Math.min(offset + 90, 365) * 86400000);
        windows.push({ from: fromDate.toISOString().slice(0, 10), to: toDate.toISOString().slice(0, 10) });
      }
      for (const windowRange of windows) {
        const params = new URLSearchParams({ listingId, ...windowRange });
        const response = await fetch(`/api/bookings/availability?${params}`);
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to load booked dates.");
        result.unavailableDates.forEach((date) => unavailableDateKeys.add(date));
      }
      if (checkInPicker) checkInPicker.set("disable", [...unavailableDateKeys]);
    }

    function clearPriceSummary(message) {
      selectedPrice = null;
      bookingNights.textContent = message;
      document.querySelector("#booking-base-cost").textContent = "";
      document.querySelector("#booking-gst-cost").textContent = "";
      document.querySelector("#booking-cleaning-cost").textContent = "";
      document.querySelector("#booking-service-cost").textContent = "";
      bookingTotal.textContent = "";
      bookStayButton.disabled = true;
    }

    async function refreshAvailability() {
      bookStayButton.disabled = true;
      if (!checkIn.value || !checkOut.value) {
        clearPriceSummary("Select dates to check availability");
        bookingMessage.textContent = "";
        return;
      }
      if (checkOut.value <= checkIn.value) {
        clearPriceSummary("Choose a check-out after check-in");
        bookingMessage.textContent = "Check-out must be after check-in.";
        bookingMessage.classList.add("booking-error");
        return;
      }

      bookingNights.textContent = "Checking availability...";
      bookingMessage.textContent = "Checking selected dates and guest capacity...";
      bookingMessage.classList.remove("booking-error");
      try {
        const params = new URLSearchParams({ listingId, checkIn: checkIn.value, checkOut: checkOut.value, guests: bookingGuests.value });
        const response = await fetch(`/api/bookings/availability?${params}`);
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to check availability.");
        selectedPrice = result.available ? result : null;
        bookingNights.textContent = `${result.nights} ${result.nights === 1 ? "night" : "nights"} × ${formatCurrency(result.pricePerNight)}`;
        document.querySelector("#booking-base-cost").textContent = `Subtotal: ${formatCurrency(result.subtotal)}`;
        document.querySelector("#booking-gst-cost").textContent = `GST (18%): ${formatCurrency(result.gstAmount)}`;
        document.querySelector("#booking-cleaning-cost").textContent = `Cleaning fee: ${formatCurrency(result.cleaningFee)}`;
        document.querySelector("#booking-service-cost").textContent = `Service fee: ${formatCurrency(result.serviceFee)}`;
        bookingTotal.textContent = formatCurrency(result.totalPrice);
        bookingMessage.textContent = result.message;
        bookingMessage.classList.toggle("booking-error", !result.available);
        bookStayButton.disabled = !result.available || isOwner;
      } catch (error) {
        clearPriceSummary(error.message);
        bookingMessage.textContent = error.message;
        bookingMessage.classList.add("booking-error");
      }
    }

    checkIn.addEventListener("change", () => {
      if (checkOut.type === "date") checkOut.min = checkIn.value || todayValue;
      refreshAvailability();
    });
    checkOut.addEventListener("change", refreshAvailability);
    bookingGuests.addEventListener("change", refreshAvailability);

    async function startTestBooking() {
      if (!selectedPrice) return;
      if (!<%= currentUser ? "true" : "false" %>) {
        const nextPath = `${window.location.pathname}?${new URLSearchParams({ checkIn: checkIn.value, checkOut: checkOut.value }).toString()}`;
        window.location.href = `/login?next=${encodeURIComponent(nextPath)}`;
        return;
      }
      bookStayButton.disabled = true;
      bookingMessage.textContent = "Creating pending booking...";
      try {
        const response = await fetch("/api/bookings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ listingId, checkIn: checkIn.value, checkOut: checkOut.value, guests: Number(bookingGuests.value) }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to create booking.");
        pendingTestOrder = { bookingId: result.booking._id, orderId: result.order.id, amount: result.order.amount };
        paymentResolved = false;
        document.querySelector("#test-payment-nights").textContent = `${selectedPrice.nights} nights × ${formatCurrency(selectedPrice.pricePerNight)}`;
        document.querySelector("#test-payment-subtotal").textContent = formatCurrency(selectedPrice.subtotal);
        document.querySelector("#test-payment-gst").textContent = formatCurrency(selectedPrice.gstAmount);
        document.querySelector("#test-payment-cleaning").textContent = formatCurrency(selectedPrice.cleaningFee);
        document.querySelector("#test-payment-service").textContent = formatCurrency(selectedPrice.serviceFee);
        document.querySelector("#test-payment-total").textContent = formatCurrency(selectedPrice.totalPrice);
        document.querySelector("#test-payment-pay").textContent = `Pay ${formatCurrency(selectedPrice.totalPrice)} (test)`;
        document.querySelector("#test-payment-message").textContent = `TEST PAYMENT · No real money is charged. Test order ${result.order.id}`;
        testPaymentDialog.showModal();
        bookingMessage.textContent = "Pending test booking created. It will be held for 15 minutes.";
      } catch (error) {
        bookingMessage.textContent = error.message;
        bookingMessage.classList.add("booking-error");
        bookStayButton.disabled = false;
      }
    }

    async function finishTestPayment(outcome) {
      if (!pendingTestOrder || paymentResolved) return;
      const actions = document.querySelector(".test-payment-actions");
      actions.querySelectorAll("button").forEach((button) => { button.disabled = true; });
      const message = document.querySelector("#test-payment-message");
      message.textContent = outcome === "success" ? "Processing test payment..." : outcome === "failure" ? "Processing simulated failure..." : "Cancelling test payment...";
      try {
        const response = await fetch("/api/payments/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...pendingTestOrder, outcome }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to process test payment.");
        paymentResolved = true;
        if (result.success) {
          message.textContent = `✓ Payment Successful · TEST PAYMENT · Transaction ID: ${result.paymentId}`;
          bookingMessage.textContent = "Test payment complete. Booking confirmed.";
          window.setTimeout(() => { window.location.href = `/bookings/${result.bookingId}`; }, 900);
          return;
        }
        message.textContent = outcome === "cancel"
          ? "Test payment cancelled. No money was charged and the booking is not confirmed."
          : "Test payment failed. No money was charged and the booking is not confirmed.";
        bookingMessage.textContent = "Payment was not completed. Your booking has not been confirmed.";
        window.setTimeout(() => testPaymentDialog.close(), 1800);
      } catch (error) {
        message.textContent = error.message;
        actions.querySelectorAll("button").forEach((button) => { button.disabled = false; });
      }
    }

    bookStayButton.addEventListener("click", startTestBooking);
    document.querySelector("#test-payment-pay").addEventListener("click", () => finishTestPayment("success"));
    document.querySelector("#test-payment-fail").addEventListener("click", () => finishTestPayment("failure"));
    document.querySelector("#test-payment-cancel").addEventListener("click", () => finishTestPayment("cancel"));
    document.querySelector("#test-payment-close").addEventListener("click", () => finishTestPayment("cancel"));
    testPaymentDialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      finishTestPayment("cancel");
    });
    loadUnavailableDates().catch((error) => {
      bookingMessage.textContent = error.message;
      bookingMessage.classList.add("booking-error");
    });

    const listingMap = document.querySelector("#listing-map");
    if (listingMap && window.mapboxgl) {
      const mapboxToken = listingMap.dataset.mapboxToken;
      const locationQuery = encodeURIComponent(listingMap.dataset.location);
      const listingTitle = listingMap.dataset.title;
      mapboxgl.accessToken = mapboxToken;

      listingMap.innerHTML = "<p class=\"map-loading\">Loading map...</p>";
      fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${locationQuery}.json?access_token=${mapboxToken}&limit=1`)
        .then((response) => response.json())
        .then((data) => {
          if (!data.features || !data.features.length) throw new Error("Location not found");
          const [longitude, latitude] = data.features[0].center;
          listingMap.replaceChildren();
          const map = new mapboxgl.Map({
            container: listingMap,
            style: "mapbox://styles/mapbox/streets-v12",
            center: [longitude, latitude],
            zoom: 10,
          });
          map.addControl(new mapboxgl.NavigationControl(), "top-right");
          const markerPopup = new mapboxgl.Popup({ offset: 28 })
            .setHTML(`<strong class="map-popup-title">${escapeHtml(listingTitle)}</strong><span class="map-popup-location">${escapeHtml(listingMap.dataset.location)}</span>`);
          const marker = new mapboxgl.Marker({ color: "#d95d39" })
            .setLngLat([longitude, latitude])
            .setPopup(markerPopup)
            .addTo(map);
          marker.getElement().addEventListener("mouseenter", () => markerPopup.addTo(map));
          map.on("error", () => {
            listingMap.innerHTML = "<p class=\"map-missing\">The map could not load. Check your Mapbox token and allowed URL settings.</p>";
          });
        })
        .catch(() => {
          listingMap.innerHTML = "<p class=\"map-missing\">We couldn't find this location on the map.</p>";
        });
    } else if (listingMap) {
      listingMap.innerHTML = "<p class=\"map-missing\">The map library could not load. Check your internet connection.</p>";
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>'"]/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "'": "&#39;",
        "\"": "&quot;"
      }[character]));
    }

    function starMarkup(rating) {
      return Array.from({ length: 5 }, (_, index) => `<i class="fa-${index < rating ? "solid" : "regular"} fa-star"></i>`).join("");
    }

    function renderReviews() {
      if (!reviews.length) {
        reviewsList.innerHTML = '<p class="reviews-empty">No reviews yet. Be the first to share your experience.</p>';
      } else {
      reviewsList.innerHTML = reviews.map((review) => `
        <article class="review-card">
          <img class="review-avatar" src="${escapeHtml(review.avatar)}" alt="${escapeHtml(review.user)}" />
          <div class="review-card-content">
            <div class="review-card-topline">
              <div>
                <h4>${escapeHtml(review.user)}</h4>
                <div class="review-stars" aria-label="${review.rating} out of 5 stars">${starMarkup(review.rating)}</div>
              </div>
              <time>${escapeHtml(review.date)}</time>
            </div>
            <p>${escapeHtml(review.comment)}</p>
          </div>
        </article>
      `).join("");
      }

      const total = reviews.length;
      const average = reviews.reduce((sum, review) => sum + review.rating, 0) / total;
      averageRating.textContent = average.toFixed(1);
      reviewCount.textContent = `${total} ${total === 1 ? "review" : "reviews"}`;
      averageStars.setAttribute("aria-label", `Average rating: ${average.toFixed(1)} out of 5`);
      averageStars.innerHTML = starMarkup(Math.round(average));

      ratingBreakdown.innerHTML = [5, 4, 3, 2, 1].map((rating) => {
        const count = reviews.filter((review) => review.rating === rating).length;
        const percentage = (count / total) * 100;
        return `<div class="rating-row"><span>${rating} stars</span><div class="rating-bar"><span style="width: ${percentage}%"></span></div><strong>${count}</strong></div>`;
      }).join("");
    }

    function formatInsightTopic(topic) {
      return topic.replaceAll("_", " ").replace(/\b\w/g, (character) => character.toUpperCase());
    }

    async function loadReviewInsights() {
      reviewInsightsStatus.textContent = "Checking review data...";
      reviewInsightsContent.hidden = true;
      try {
        const response = await fetch(`/api/listings/${listingId}/review-insights`);
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to load guest insights.");
        if (!result.available) {
          reviewInsightsStatus.textContent = result.message;
          return;
        }

        reviewInsightsSentiment.textContent = `Overall guest sentiment: ${result.sentiment.replaceAll("_", " ")}`;
        reviewInsightsPositive.replaceChildren(...result.positiveTopics.map((topic) => {
          const item = document.createElement("li");
          item.textContent = formatInsightTopic(topic);
          return item;
        }));
        reviewInsightsNegative.replaceChildren(...result.negativeTopics.map((topic) => {
          const item = document.createElement("li");
          item.textContent = formatInsightTopic(topic);
          return item;
        }));
        reviewInsightsSummary.textContent = result.summary;
        reviewInsightsStatus.textContent = `Based on ${result.analyzedReviewCount} distinct guest reviews.`;
        reviewInsightsContent.hidden = false;
      } catch (error) {
        reviewInsightsStatus.textContent = error.message;
        reviewInsightsStatus.classList.add("review-insights-error");
      }
    }

    async function loadReviews() {
      reviewsList.innerHTML = '<p class="reviews-loading">Loading reviews...</p>';
      try {
        const response = await fetch(`/api/listings/${listingId}/reviews`);
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to load reviews.");
        reviews.push(...result.reviews.map((review) => ({
          id: review._id,
          user: review.user.username,
          rating: review.rating,
          comment: review.comment,
          date: new Date(review.createdAt).toLocaleDateString("en-IN", { month: "long", year: "numeric" }),
          avatar: `https://ui-avatars.com/api/?name=${encodeURIComponent(review.user.username)}&background=fde8e1&color=c24f32`
        })));
        renderReviews();
      } catch (error) {
        reviewsList.innerHTML = `<p class="reviews-error">${escapeHtml(error.message)}</p>`;
      }
    }

    async function loadCurrentUser() {
      const response = await fetch("/auth/me");
      const result = await response.json();
      if (result.user) {
        reviewAuthStatus.textContent = `Reviewing as ${result.user.username}.`;
        reviewAuthStatus.classList.add("is-authenticated");
      }
    }

    document.querySelectorAll(".star-choice").forEach((button) => {
      button.addEventListener("click", () => {
        const selectedRating = Number(button.dataset.rating);
        reviewRating.value = selectedRating;
        document.querySelectorAll(".star-choice").forEach((star) => {
          star.classList.toggle("selected", Number(star.dataset.rating) <= selectedRating);
        });
      });
    });

    reviewForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const comment = document.querySelector("#review-comment").value.trim();
      const rating = Number(reviewRating.value);

      if (!rating) {
        reviewSuccess.textContent = "Please choose a star rating.";
        reviewSuccess.classList.add("review-error");
        return;
      }

      reviewSuccess.textContent = "Submitting review...";
      fetch(`/api/listings/${listingId}/reviews`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ rating, comment })
      })
        .then(async (response) => {
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || "Unable to submit review.");
          return result.review;
        })
        .then((review) => {
          reviews.unshift({
            id: review._id,
            user: review.user.username,
            rating: review.rating,
            comment: review.comment,
            date: "Just now",
            avatar: `https://ui-avatars.com/api/?name=${encodeURIComponent(review.user.username)}&background=fde8e1&color=c24f32`
          });
          renderReviews();
          reviewForm.reset();
          reviewRating.value = "0";
          document.querySelectorAll(".star-choice").forEach((star) => star.classList.remove("selected"));
          reviewSuccess.classList.remove("review-error");
          reviewSuccess.textContent = "Review submitted successfully.";
          loadReviewInsights();
        })
        .catch((error) => {
          reviewSuccess.classList.add("review-error");
          reviewSuccess.textContent = error.message;
        });
    });

    loadCurrentUser().catch(() => {});
    loadReviews();
    loadReviewInsights();
  </script>
