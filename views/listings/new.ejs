<% layout("layouts/boilerplate") %>
  <main class="form-page">
    <a class="back-link" href="/listings">
      <i class="fa-solid fa-arrow-left"></i>
      Back to all listings
    </a>
    <div class="form-heading">
      <p class="form-eyebrow">Share a place worth remembering</p>
      <h1>Create a New Listing</h1>
      <p>Add the details guests need to discover your place.</p>
    </div>

    <form class="listing-form" method="POST" action="/listings">
      <div class="form-field">
        <label for="title">Title</label>
        <input id="title" name="listing[title]" placeholder="e.g. Cozy Beachfront Cottage" type="text" required />
      </div>
      <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="listing[description]" placeholder="Tell guests what makes this place special" required></textarea>
      </div>
      <div class="form-field">
        <label for="image">Image URL</label>
        <input id="image" name="listing[image]" placeholder="https://example.com/your-image.jpg" type="url" />
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="price">Price per night</label>
          <input id="price" name="listing[price]" placeholder="1500" type="number" min="0" required />
        </div>
        <div class="form-field">
          <label for="country">Country</label>
          <input id="country" name="listing[country]" placeholder="India" type="text" required />
        </div>
      </div>
      <div class="form-field">
        <label for="location">Location</label>
        <input id="location" name="listing[location]" placeholder="Goa" type="text" required />
      </div>
      <button class="form-submit" type="submit">
        <i class="fa-solid fa-plus"></i>
        Add listing
      </button>
    </form>
  </main>
