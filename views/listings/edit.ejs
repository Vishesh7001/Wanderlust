<% layout("layouts/boilerplate") %>
  <main class="form-page">
    <a class="back-link" href="/listings/<%= listing._id %>">
      <i class="fa-solid fa-arrow-left"></i>
      Back to listing
    </a>
    <div class="form-heading">
      <p class="form-eyebrow">Keep your place up to date</p>
      <h1>Edit your Listing</h1>
      <p>Refresh the details so guests always know what to expect.</p>
    </div>

    <form class="listing-form" method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data">
      <% if (formError) { %><p class="form-error" role="alert"><%= formError %></p><% } %>
      <div class="form-field">
        <label for="title">Title</label>
        <input id="title" name="listing[title]" value="<%= listing.title %>" type="text" required />
      </div>
      <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="listing[description]" required><%= listing.description %></textarea>
      </div>
      <div class="form-field">
        <label for="image">Replace property image</label>
        <input id="image" name="listing[images]" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
        <span class="form-help">Leave empty to keep current photos; selecting new photos replaces them. Up to 8 images, 5 MB each.</span>
        <div class="image-preview-grid" id="image-preview" aria-live="polite">
          <% for (const image of (listing.images && listing.images.length ? listing.images : [listing.image])) { %>
            <div class="image-preview-item current-image" data-image-url="<%= image %>">
              <img src="<%= image %>" alt="Current property image" />
              <button class="image-remove" type="button" aria-label="Remove this image"><i class="fa-solid fa-xmark"></i></button>
            </div>
          <% } %>
        </div>
        <div id="existing-image-fields"></div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="price">Price per night</label>
          <input id="price" name="listing[price]" value="<%= listing.price %>" type="number" min="0" required />
        </div>
        <div class="form-field">
          <label for="country">Country</label>
          <input id="country" name="listing[country]" value="<%= listing.country %>" type="text" required />
        </div>
      </div>
      <div class="form-field">
        <label for="location">Location</label>
        <input id="location" name="listing[location]" value="<%= listing.location %>" type="text" required />
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="property-type">Property type</label>
          <select id="property-type" name="listing[propertyType]" required>
            <% for (const type of ["Apartment", "House", "Cabin", "Villa", "Guesthouse", "Other"]) { %>
              <option value="<%= type %>" <%= listing.propertyType === type ? "selected" : "" %>><%= type %></option>
            <% } %>
          </select>
        </div>
        <div class="form-field">
          <label for="bedrooms">Bedrooms</label>
          <input id="bedrooms" name="listing[bedrooms]" type="number" min="0" max="100" value="<%= listing.bedrooms %>" required />
        </div>
      </div>
      <div class="form-field">
        <label for="bathrooms">Bathrooms</label>
        <input id="bathrooms" name="listing[bathrooms]" type="number" min="0" max="100" value="<%= listing.bathrooms %>" required />
      </div>
      <div class="form-field">
        <label for="max-guests">Maximum guests</label>
        <input id="max-guests" name="listing[maxGuests]" type="number" min="1" max="100" value="<%= listing.maxGuests || 2 %>" required />
      </div>
      <fieldset class="amenities-fieldset">
        <legend>Amenities</legend>
        <div class="amenities-options">
          <input type="hidden" name="listing[amenities]" value="" />
          <% for (const amenity of ["Wifi", "Kitchen", "Air conditioning", "Pool", "Parking"]) { %>
            <label><input type="checkbox" name="listing[amenities]" value="<%= amenity %>" <%= (listing.amenities || []).includes(amenity) ? "checked" : "" %> /> <%= amenity %></label>
          <% } %>
        </div>
      </fieldset>
      <button class="form-submit" type="submit">
        <i class="fa-solid fa-check"></i>
        Save changes
      </button>
    </form>
  </main>
  <script>
    const imageInput = document.querySelector("#image");
    const imagePreview = document.querySelector("#image-preview");
    const existingImageFields = document.querySelector("#existing-image-fields");
    let existingImages = [...document.querySelectorAll(".current-image")].map((item) => item.dataset.imageUrl);
    function writeExistingImageFields() {
      existingImageFields.replaceChildren();
      (existingImages.length ? existingImages : [""]).forEach((image) => {
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "listing[existingImages]";
        input.value = image;
        existingImageFields.append(input);
      });
    }
    writeExistingImageFields();
    document.querySelectorAll(".current-image .image-remove").forEach((button) => {
      button.addEventListener("click", () => {
        const item = button.closest(".current-image");
        existingImages = existingImages.filter((image) => image !== item.dataset.imageUrl);
        item.remove();
        writeExistingImageFields();
      });
    });
    imageInput.addEventListener("change", () => {
      const transfer = new DataTransfer();
      [...imageInput.files].slice(0, 8).forEach((file) => transfer.items.add(file));
      imageInput.files = transfer.files;
      existingImages = [];
      document.querySelectorAll(".current-image").forEach((item) => item.remove());
      writeExistingImageFields();
      imagePreview.replaceChildren();
      [...imageInput.files].forEach((file, index) => {
        const wrapper = document.createElement("div");
        wrapper.className = "image-preview-item";
        const image = document.createElement("img");
        image.src = URL.createObjectURL(file);
        image.alt = file.name;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "image-remove";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.innerHTML = '<i class="fa-solid fa-xmark"></i>';
        remove.addEventListener("click", () => {
          const nextFiles = new DataTransfer();
          [...imageInput.files].filter((_, fileIndex) => fileIndex !== index).forEach((selected) => nextFiles.items.add(selected));
          imageInput.files = nextFiles.files;
          imagePreview.replaceChildren();
          imageInput.dispatchEvent(new Event("change"));
        });
        wrapper.append(image, remove);
        imagePreview.append(wrapper);
      });
    });
  </script>
