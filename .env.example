MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/wanderlust?retryWrites=true&w=majority

# REQUIRED in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, sessions reset on every Render restart (users get logged out).
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Set to "production" on Render to enable secure cookies.
NODE_ENV=production

MAPBOX_TOKEN=replace-with-your-mapbox-public-token
PAYMENT_MODE=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
